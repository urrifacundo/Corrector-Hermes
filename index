  if(!/\b(calles?|av\.?|avda|avenida|ruta|km\.?|intersecci[oó]n|esquina|esq\.|e\/|entre|N[°º.]+\s*\d|B[°º]|barrio|paseo|mza|manzana|lote|casa|objetivo)\b/i.test(exAddr)&&!/\b[A-ZÁÉÍÓÚ][a-záéíóúñ]+\s+\d{2,5}\b/.test(exAddr))add('EXTRACTO','error','EXT_SINDOM','Sin domicilio del procedimiento','No se encontró dirección. Según la guía: enviar el PU a Facundo Urribarri; no georreferenciar al centro de la localidad.');
  const objs=[...ex.matchAll(/\bObj(?:etivo)?\.?\s*(\d+)\s*[:)]/gi)].map(m=>m[1]);const dup=objs.find((x,i)=>objs.indexOf(x)!==i);
  if(dup)add('EXTRACTO','formato','EXT_OBJ','Objetivo '+dup+' repetido','La numeración de objetivos se repite.');
  if(title_locs(r,v,part))0;
 }
 const ments=mentionedPlaces(ex);r.mentions=ments;
 if(part&&ments.length&&mod==='procedimientos'){const parts=[...new Set(ments.flatMap(m=>m.parts.includes(part)?[part]:m.parts))];
  if(!parts.includes(part))add('EXTRACTO','revisar','EXT_OTROPART','El extracto ubica en '+parts.slice(0,2).join(' / '),'Lugares mencionados: '+ments.map(m=>m.text).join(', ')+'. El partido cargado es '+part+'.');
  else if(parts.length>1&&objs_count(ex)>1)add('EXTRACTO','revisar','EXT_VARIOS','Objetivos en varios partidos','Hay objetivos en '+parts.join(', ')+'. La guía pide solicitar criterio de carga y no elegir uno al azar.')}
 for(const f of req)if(!g(f)&&!r.issues.some(i=>i.f===f&&i.code==='VACIO'))r.issues.unshift({f,sev:'error',code:'VACIO',msg:'Falta completar',why:'Campo obligatorio vacío.',fix:'',auto:false});
 return r;
}
function objs_count(ex){return new Set([...String(ex).matchAll(/\bObj(?:etivo)?\.?\s*(\d+)/gi)].map(m=>m[1])).size}
function title_locs(r,v,part){
 if(!r.title)return false;const segs=r.title.segs.slice(0,3).filter(s=>s&&s===s.toUpperCase()&&s.length<40&&!/\d/.test(s));if(!segs.length)return false;
 const lk=key(v.LOCALIDAD),pk=key(v.PARTIDO);let ok=false,cands=[];
 for(const s of segs){const k=expandAbbr(key(s));const P=findPartido(s),L=lookupLocalidad(s);if(!P&&!L.length)continue;cands.push(s);
  if(k===lk||k===pk||(P&&P===part)||L.some(e=>e.part===part))ok=true}
 if(cands.length&&!ok){r.issues.push({f:'LOCALIDAD',sev:'revisar',code:'LOC_TIT',msg:'El título dice '+cands[0],why:'El título del extracto ubica el procedimiento en «'+cands.join(' – ')+'», pero la planilla dice '+clean(v.LOCALIDAD)+' / '+clean(v.PARTIDO)+'.',fix:'',auto:false});return true}
 if(!cands.length){const s=segs[0],k=expandAbbr(key(s));if(k&&k!==lk&&k!==pk&&!r.issues.some(i=>i.f==='LOCALIDAD'))r.issues.push({f:'LOCALIDAD',sev:'revisar',code:'LOC_TIT',msg:'El título dice '+s,why:'El título del extracto dice «'+s+'» y la localidad cargada es '+clean(v.LOCALIDAD)+'. Puede ser un barrio: verificar.',fix:'',auto:false})}
 return false;
}
function finalize(r){const sevs=r.issues.map(i=>i.sev);r.status=sevs.includes('error')?'error':sevs.includes('revisar')?'revisar':sevs.includes('formato')?'formato':'ok';r.n={error:sevs.filter(s=>s==='error').length,revisar:sevs.filter(s=>s==='revisar').length,formato:sevs.filter(s=>s==='formato').length}}
function auditAll(rows,mod){
 const recs=rows.map(({v,rowNo})=>auditRow(v,rowNo,mod));
 /* cruces entre filas */
 const byPU=new Map(),byC=new Map(),dates=new Map();
 for(const r of recs){if(r.pu){if(byPU.has(r.pu))byPU.get(r.pu).push(r);else byPU.set(r.pu,[r])}
  if(r.point){const k=r.point[0].toFixed(5)+','+r.point[1].toFixed(5);if(byC.has(k))byC.get(k).push(r);else byC.set(k,[r])}
  if(r.date){const k=dKey(r.date);dates.set(k,(dates.get(k)||0)+1)}}
 for(const [pu,L] of byPU)if(L.length>1)for(const r of L)r.issues.push({f:'PU',sev:'revisar',code:'PU_DUP',msg:'PU repetido (filas '+L.map(x=>x.rowNo).join(', ')+')',why:'El mismo PU aparece en más de una fila. Si es una ampliación, actualizar el registro original en lugar de crear otro.',fix:'',auto:false});
 for(const [c,L] of byC)if(L.length>1)for(const r of L)r.issues.push({f:'COORDENADAS',sev:'revisar',code:'COORD_DUP',msg:'Repetida en filas '+L.filter(x=>x!==r).map(x=>x.rowNo).join(', '),why:'La misma coordenada se usó para hechos distintos.',fix:'',auto:false});
 const top=[...dates].sort((a,b)=>b[1]-a[1])[0];
 if(top&&top[1]>=3&&top[1]>recs.length*.6)for(const r of recs)if(r.date&&dKey(r.date)!==top[0]&&!r.issues.some(i=>i.code==='FECHA_EXT'))r.issues.push({f:'FECHA',sev:'revisar',code:'FECHA_DIST',msg:'Distinta al resto ('+top[0].split('-').reverse().join('/')+')',why:'La mayoría de los registros tiene otra fecha.',fix:'',auto:false});
 for(const r of recs){r.special=detectSpecial(r,mod);finalize(r);r.issues.sort((a,b)=>({error:0,revisar:1,formato:2})[a.sev]-({error:0,revisar:1,formato:2})[b.sev])}
 return recs;
}
</script>
<script>/* ===================== INTERFAZ ===================== */
const $=id=>document.getElementById(id);
const S={recs:[],mod:'',file:'',headers:[],rows:[],hi:0,view:'cards',status:'all',field:'',code:'',q:''};
const SEVN={error:'Error',revisar:'Revisar',formato:'Formato'};
const COLS={relevantes:['FECHA','PARTIDO','LOCALIDAD','JURISDICCION','DELITO','MODALIDAD','PU','COORDENADAS','EXTRACTO'],procedimientos:['ESPECIALIDAD','FECHA','PARTIDO','LOCALIDAD','CARATULA','PU','COORDENADAS','EXTRACTO']};
function toast(t){const d=document.createElement('div');d.className='toast';d.textContent=t;document.body.appendChild(d);setTimeout(()=>d.remove(),2200)}

async function handleFile(f){
 if(!f)return;if(!window.XLSX){$('status').textContent='No se pudo cargar el lector de Excel.';return}
 try{
  const wb=XLSX.read(await f.arrayBuffer(),{type:'array',cellDates:false});
  let ws=null,rows=null,hi=-1;
  for(const n of wb.SheetNames){const r=XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,defval:'',raw:true});const h=r.findIndex(a=>a.some(x=>norm(x)==='extracto'));if(h>=0){ws=wb.Sheets[n];rows=r;hi=h;break}}
  if(hi<0)throw Error('no encontré una columna EXTRACTO en ninguna hoja');
  const H=rows[hi].map(x=>stripAcc(clean(x)).toUpperCase());
  const mod=$('mode').value==='auto'?(H.includes('JURISDICCION')||H.includes('DELITO')?'relevantes':'procedimientos'):$('mode').value;
  const data=rows.slice(hi+1).map((a,i)=>({a,rowNo:hi+i+2})).filter(({a})=>a.some(x=>clean(x)!=='')).map(({a,rowNo})=>({v:Object.fromEntries(H.map((h,i)=>[h,a[i]??''])),rowNo,a}));
  const miss=COLS[mod].filter(c=>!H.includes(c));
  Object.assign(S,{mod,file:f.name,headers:H,origHeaders:rows[hi],rows:data,hi,code:'',status:'all',field:''});
  S.recs=auditAll(data,mod);S.recs.forEach((r,i)=>r.a=data[i].a);
  $('dropTitle').textContent=f.name;$('dropSub').textContent='Hacé clic o arrastrá otra planilla para auditarla.';
  const e=S.recs.filter(r=>r.status==='error').length;
  $('status').innerHTML=`<b>${esc(mod==='relevantes'?'Hechos Relevantes':'Procedimientos')}</b> · ${S.recs.length} registros · ${e} con errores`+(miss.length?` · <span style="color:var(--err)">Faltan columnas: ${esc(miss.join(', '))}</span>`:'');
  ['btnCopy','btnFixed','btnExport','btnGeo'].forEach(id=>$(id).disabled=false);
  $('results').hidden=false;$('emptyState').hidden=true;
  const fs=[...new Set(S.recs.flatMap(r=>r.issues.map(i=>i.f)))];$('fField').innerHTML='<option value="">Todos los campos</option>'+COLS[mod].filter(c=>fs.includes(c)).map(c=>`<option value="${c}">${FIELD_LABEL[c]}</option>`).join('');
  renderAll();
 }catch(err){$('status').innerHTML='<span style="color:var(--err)">No se pudo auditar: '+esc(err.message)+'</span>';console.error(err)}
}
$('file').addEventListener('change',e=>handleFile(e.target.files[0]));
const drop=$('drop');['dragenter','dragover'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('over')}));['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('over')}));
drop.addEventListener('drop',e=>{const f=e.dataTransfer.files[0];if(f)handleFile(f)});
document.addEventListener('dragover',e=>e.preventDefault());document.addEventListener('drop',e=>{e.preventDefault();const f=e.dataTransfer&&e.dataTransfer.files[0];if(f)handleFile(f)});
$('mode').addEventListener('change',()=>{const f=$('file').files[0];if(f)handleFile(f)});

function renderAll(){renderKpis();renderSpecial();renderView()}
function renderKpis(){const R=S.recs,c=s=>R.filter(r=>r.status===s).length,h=R.filter(r=>r.special.hom).length,en=R.filter(r=>r.special.enf).length;
 const k=[['all','','Registros',R.length],['error','k-err','Con error',c('error')],['revisar','k-warn','A revisar',c('revisar')],['formato','k-fmt','Solo formato',c('formato')],['ok','k-ok','Sin observ.',c('ok')],['hom','k-hom','Homicidios',h],['enf','k-enf','Enfrentam.',en]];
 $('kpis').innerHTML=k.map(([s,cl,l,n])=>`<button class="kpi ${cl} ${S.status===s?'on':''}" data-s="${s}"><small>${l}</small><strong>${n}</strong></button>`).join('');
}
$('kpis').addEventListener('click',e=>{const b=e.target.closest('.kpi');if(!b)return;S.status=S.status===b.dataset.s?'all':b.dataset.s;S.code='';if(S.view==='types')setView('cards');renderKpis();renderView()});
function specLine(r,kind){const sp=r.special,st=sp[kind],why=kind==='hom'?sp.homWhy:sp.enfWhy;const v=r.v;
 return `<div class="spitem"><span class="r">Fila ${r.rowNo}</span><div class="t"><b>${esc(clean(v.PARTIDO)||'—')} · ${esc(clean(v.LOCALIDAD)||'—')}</b> <span class="pill ${st==='confirmado'?'conf':'pos'}">${st==='confirmado'?'Confirmado':'Verificar'}</span><span class="sub">${r.pu?'PU '+esc(r.pu)+' · ':''}${esc(why)}</span></div><button class="btn" data-copy="${kind}" data-row="${r.rowNo}">Copiar ficha</button></div>`}
function renderSpecial(){const H=S.recs.filter(r=>r.special.hom),E=S.recs.filter(r=>r.special.enf);
 $('special').innerHTML=`<div class="spbox hom"><h2>Homicidios · cargar aparte (${H.length})</h2><p>Además de estar en la planilla, van en el módulo Homicidios PBA. Coordenadas en un solo campo «lat, long».</p>${H.map(r=>specLine(r,'hom')).join('')||'<div class="spempty">No se detectaron homicidios en esta planilla.</div>'}</div>
 <div class="spbox enf"><h2>Enfrentamientos · cargar aparte (${E.length})</h2><p>Solo si consta que ambas partes estaban armadas. Latitud y longitud en campos separados.</p>${E.map(r=>specLine(r,'enf')).join('')||'<div class="spempty">No se detectaron enfrentamientos en esta planilla.</div>'}</div>`}
$('special').addEventListener('click',e=>{const b=e.target.closest('[data-copy]');if(b){const r=S.recs.find(x=>x.rowNo==b.dataset.row);copyText(fichaText(r,b.dataset.copy),'Ficha copiada');return}
 const it=e.target.closest('.spitem');if(it){const n=it.querySelector('.r').textContent.replace(/\D/g,'');S.status='all';S.code='';setView('cards');renderKpis();renderView();const el=$('rec-'+n);if(el){el.scrollIntoView({behavior:'smooth',block:'center'});el.classList.add('flash');setTimeout(()=>el.classList.remove('flash'),1600)}}});
function fichaFields(r,kind){const v=r.v,f=r.fix||{},p=r.point;const val=k=>clean(fixedValue(r,k));const base=[['FECHA',dStr(r.date)||clean(v.FECHA)],['PU',r.pu],['PARTIDO',val('PARTIDO')],['LOCALIDAD',val('LOCALIDAD')],['JURISDICCION',S.mod==='relevantes'?val('JURISDICCION'):'']];
 if(kind==='hom')return[...base,['DELITO',val(S.mod==='relevantes'?'DELITO':'CARATULA')],['ARMA',r.special.arma],['COORDENADAS',p?p[0]+', '+p[1]:clean(v.COORDENADAS)],['EXTRACTO',fixedValue(r,'EXTRACTO')]];
 return[...base,['HECHO DELICTIVO',val(S.mod==='relevantes'?'DELITO':'CARATULA')],['CONTEXTO',''],['LATITUD',p?String(p[0]):''],['LONGITUD',p?String(p[1]):''],['EXTRACTO',fixedValue(r,'EXTRACTO')]]}
function fichaText(r,kind){return fichaFields(r,kind).map(([k,v])=>k+': '+(v||'')).join('\n')}

/* filtros */
function visible(){const q=norm(S.q);return S.recs.filter(r=>{
 if(S.status==='hom'&&!r.special.hom)return false;if(S.status==='enf'&&!r.special.enf)return false;
 if(['error','revisar','formato','ok'].includes(S.status)&&r.status!==S.status)return false;
 if(S.field&&!r.issues.some(i=>i.f===S.field))return false;if(S.code&&!r.issues.some(i=>i.code===S.code))return false;
 if(q){const hay=norm(['fila '+r.rowNo,r.pu,...Object.values(r.v),...r.issues.map(i=>i.msg+' '+i.fix)].join(' '));if(!hay.includes(q))return false}
 return true})}
$('fField').addEventListener('change',e=>{S.field=e.target.value;renderView()});
$('fSearch').addEventListener('input',e=>{S.q=e.target.value;renderView()});
document.querySelector('.tabs').addEventListener('click',e=>{const b=e.target.closest('.tab');if(b){setView(b.dataset.view);renderView()}});
function setView(v){S.view=v;document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.dataset.view===v))}
function renderView(){if(S.view==='table')return renderTable();if(S.view==='types')return renderTypes();renderCards()}

function markedExtract(r){const s=String(r.v.EXTRACTO??'');const ms=[...r.marks].sort((a,b)=>a.i-b.i);let out='',pos=0;for(const m of ms){if(m.i<pos)continue;out+=esc(s.slice(pos,m.i))+`<mark class="m-${m.sev}" title="${esc(m.label)}">${esc(s.substr(m.i,m.len))}</mark>`;pos=m.i+m.len}return out+esc(s.slice(pos))}
function issueLi(i){const fx=i.fix&&!String(i.msg).includes(i.fix)?`<span class="fix">${esc(i.fix)}</span>`:'';return `<li class="iss ${i.sev}"><span class="dot" title="${SEVN[i.sev]}"></span><span class="fld">${FIELD_LABEL[i.f]||i.f}</span><span class="msg"><span class="m">${esc(i.msg)}</span>${fx}${i.auto&&i.fix?'<span class="auto">auto</span>':''}<span class="why">${esc(i.why)}</span></span></li>`}
function renderCards(){const L=visible();
 if(!L.length){$('view').innerHTML='<div class="empty"><b>Sin registros para este filtro</b>Probá con otro estado o campo.</div>';return}
 $('view').innerHTML='<div class="list">'+L.map(r=>{const v=r.v,del=S.mod==='relevantes'?[clean(v.DELITO),clean(v.MODALIDAD)].filter(Boolean).join(' · '):clean(v.CARATULA);
  const tags=(r.special.hom?`<span class="tag hom">Homicidio${r.special.hom==='posible'?'?':''}</span>`:'')+(r.special.enf?`<span class="tag enf">Enfrentamiento${r.special.enf==='posible'?'?':''}</span>`:'');
  const cnt=(r.n.error?`<span class="cnt e">${r.n.error} error${r.n.error>1?'es':''}</span>`:'')+(r.n.revisar?`<span class="cnt w">${r.n.revisar} revisar</span>`:'')+(r.n.formato?`<span class="cnt f">${r.n.formato} formato</span>`:'')+(r.status==='ok'?'<span class="cnt o">OK</span>':'');
  const iss=S.field?r.issues.filter(i=>i.f===S.field):r.issues;
  return `<article class="rec s-${r.status}" id="rec-${r.rowNo}"><div class="rhead"><span class="row">Fila ${r.rowNo}</span><span class="row">${r.pu?'PU '+esc(r.pu):'Sin PU'}</span><span class="where">${esc(clean(v.PARTIDO)||'—')} · ${esc(clean(v.LOCALIDAD)||'—')}</span><span class="what">${esc(del)}</span>${tags}<span class="grow"></span><span class="counts">${cnt}</span></div>
  ${iss.length?'<ul class="issues">'+iss.map(issueLi).join('')+'</ul>':'<div class="ok-line">Sin observaciones automáticas.</div>'}
  <details class="ext"><summary>Ver extracto${r.marks.length?' ('+r.marks.length+' marcas)':''}</summary><p class="extract">${markedExtract(r)}</p><div class="meta">${S.mod==='relevantes'?`<span>Jurisdicción del extracto: <b>${esc(r.jurExt||'—')}</b></span>`:''}<span>Partido según coordenada: <b>${esc(r.geoPart||'—')}</b></span>${r.geoNote?`<span>${esc(r.geoNote)}</span>`:''}</div></details></article>`}).join('')+'</div>'}
$('view').addEventListener('click',e=>{const li=e.target.closest('.iss');if(li)li.classList.toggle('open');const tr=e.target.closest('.trow');if(tr){S.code=tr.dataset.code;S.status='all';setView('cards');renderKpis();renderView();window.scrollTo({top:$('results').offsetTop-70,behavior:'smooth'})}});

function cellIssue(r,f){const L=r.issues.filter(i=>i.f===f);if(!L.length)return null;return L.find(i=>i.sev==='error')||L.find(i=>i.sev==='revisar')||L[0]}
function renderTable(){const L=visible(),cols=COLS[S.mod];
 const head='<tr><th>Fila</th><th>Estado</th>'+cols.map(c=>`<th>${FIELD_LABEL[c]}</th>`).join('')+'</tr>';
 const body=L.map(r=>'<tr><td class="mono">'+r.rowNo+'</td><td><span class="st '+r.status+'">'+(r.status==='ok'?'OK':SEVN[r.status])+'</span>'+(r.special.hom?'<br><span class="tag hom">HOM</span>':'')+(r.special.enf?'<br><span class="tag enf">ENF</span>':'')+'</td>'+cols.map(c=>{const i=cellIssue(r,c);let val=c==='FECHA'?(dStr(r.date)||clean(r.v[c])):clean(r.v[c]);
  if(c==='EXTRACTO')return `<td class="ex ${i?'c-'+i.sev:''}" title="${esc(i?r.issues.filter(x=>x.f===c).map(x=>x.msg).join(' · '):'')}"><div>${esc(val)}</div>${i?'<small>'+esc(r.issues.filter(x=>x.f===c).map(x=>x.msg).join(' · '))+'</small>':''}</td>`;
  return `<td class="${i?'c-'+i.sev:''}" title="${esc(i?i.why:'')}">${esc(val||'—')}${i?`<small>${esc(i.fix?'→ '+i.fix:i.msg)}</small>`:''}</td>`}).join('')+'</tr>').join('');
 $('view').innerHTML=`<div class="tablewrap"><table><thead>${head}</thead><tbody>${body||'<tr><td colspan="12">Sin registros.</td></tr>'}</tbody></table></div>`}
function renderTypes(){const m=new Map();for(const r of S.recs)for(const i of r.issues){const k=i.code+'|'+i.f;if(!m.has(k))m.set(k,{code:i.code,f:i.f,sev:i.sev,msg:i.msg,rows:new Set()});m.get(k).rows.add(r.rowNo)}
 const L=[...m.values()].sort((a,b)=>({error:0,revisar:1,formato:2})[a.sev]-({error:0,revisar:1,formato:2})[b.sev]||b.rows.size-a.rows.size);const max=Math.max(1,...L.map(x=>x.rows.size));
 const label=x=>({VACIO:'Campo vacío',PART_ESLOC:'Localidad cargada como partido',PART_TILDE:'Pueyrredon con tilde',LOC_INV:'Partido y localidad invertidos',CAT_ALIAS:'No es opción de HERMES',CAT_NONE:'Fuera del catálogo',CAT_FUZZY:'Mal escrito',CAT_FMT:'Distinto al catálogo (mayúsculas/tildes)',CAT_ESP:'Espacios sobrantes',EXT_ORTO:'Ortografía',DEL_HEADER:'No coincide con el encabezado',TIT_DELITO:'No coincide con el título',LOC_TIT:'El título nombra otro lugar',FECHA_DIST:'Fecha distinta al resto',COORD_DUP:'Coordenada repetida',PU_DUP:'PU repetido'}[x.code]||x.msg.replace(/[:(].*$/,''));
 $('view').innerHTML='<div class="types">'+(L.map(x=>`<div class="trow ${x.sev}" data-code="${x.code}"><span class="dot" style="background:var(--${x.sev==='error'?'err':x.sev==='revisar'?'warn':'fmt'})"></span><span class="lbl"><b>${FIELD_LABEL[x.f]||x.f}</b>${esc(label(x))}</span><span class="barbg"><span class="barfill" style="display:block;width:${Math.round(x.rows.size/max*100)}%"></span></span><span class="n">${x.rows.size}</span></div>`).join('')||'<div class="ok-line">Sin observaciones.</div>')+'</div>'}

/* copiar */
async function copyText(t,msg){try{await navigator.clipboard.writeText(t);toast(msg||'Copiado')}catch(_){const ta=$('copyArea');ta.hidden=false;ta.value=t;ta.select();try{document.execCommand('copy');toast(msg||'Copiado')}catch(e){toast('No se pudo copiar')}ta.hidden=true}}
$('btnCopy').addEventListener('click',()=>{const L=S.recs.filter(r=>r.n.error||r.n.revisar);
 const t=['AUDITORÍA HERMES · '+S.file,S.recs.length+' registros · '+S.recs.filter(r=>r.status==='error').length+' con errores · '+S.recs.filter(r=>r.status==='revisar').length+' a revisar',''];
 for(const r of L){t.push('Fila '+r.rowNo+(r.pu?' · PU '+r.pu:'')+' · '+clean(r.v.PARTIDO)+' / '+clean(r.v.LOCALIDAD));for(const i of r.issues.filter(i=>i.sev!=='formato'))t.push('  '+(i.sev==='error'?'✗':'!')+' '+(FIELD_LABEL[i.f]||i.f).toUpperCase()+': '+i.msg+(i.fix&&!i.msg.includes(i.fix)?' → '+i.fix:''));t.push('')}
 const H=S.recs.filter(r=>r.special.hom),E=S.recs.filter(r=>r.special.enf);
 if(H.length||E.length){t.push('CARGAR APARTE:');H.forEach(r=>t.push('  Homicidio · Fila '+r.rowNo+(r.pu?' · PU '+r.pu:'')+' ('+(r.special.hom==='confirmado'?'confirmado':'verificar')+')'));E.forEach(r=>t.push('  Enfrentamiento · Fila '+r.rowNo+(r.pu?' · PU '+r.pu:'')+' ('+(r.special.enf==='confirmado'?'confirmado':'verificar')+')'))}
 const fm=S.recs.filter(r=>r.n.formato).length;if(fm)t.push('','Además hay '+fm+' registros con detalles de formato (espacios, tildes, mayúsculas).');
 copyText(t.join('\n'),'Devolución copiada')});

/* ===== exportación ===== */
function fixedValue(r,f){const it=r.issues.filter(i=>i.f===f&&i.auto&&i.fix);if(f==='EXTRACTO')return r.fixedExtract??r.v.EXTRACTO;if(it.length)return it[0].fix;if(typeof r.v[f]==='string')return r.v[f].trim();return r.v[f]}
const FILL={error:'F8D7DA',revisar:'FFEFC7',formato:'DCE7F5',fix:'D4F2E6',head:'1D4F91',hom:'F6D9E2',enf:'E7DCF6'};
const cellStyle=(rgb,bold,color)=>({fill:{patternType:'solid',fgColor:{rgb}},font:{bold:!!bold,color:{rgb:color||'1A1A1A'}},alignment:{vertical:'top',wrapText:true},border:{bottom:{style:'thin',color:{rgb:'D6DDE6'}}}});
function headStyle(){return{fill:{patternType:'solid',fgColor:{rgb:FILL.head}},font:{bold:true,color:{rgb:'FFFFFF'}},alignment:{vertical:'center',wrapText:true}}}
function mkCell(v,f){if(f==='FECHA'&&typeof v==='number')return{t:'n',v,z:'dd/mm/yyyy'};if(typeof v==='number')return{t:'n',v};return{t:'s',v:String(v??'')}}
function sheetFrom(aoa){const ws=XLSX.utils.aoa_to_sheet(aoa);return ws}
function widths(H){return H.map(h=>({wch:/EXTRACTO|OBSERV|DETALLE/.test(h)?70:/COORD/.test(h)?24:/JURIS|DELITO|MODAL|CARAT|MOTIVO/.test(h)?24:14}))}
function exportAudit(){
 const H=S.origHeaders.map(String),cols=S.headers,extra=['ESTADO','ERRORES','REVISAR','FORMATO','OBSERVACIONES','HOMICIDIO','ENFRENTAMIENTO'];
 const aoa=[[...H,...extra]];
 for(const r of S.recs)aoa.push([...cols.map((c,j)=>r.a[j]??''),r.status==='ok'?'OK':SEVN[r.status].toUpperCase(),r.n.error,r.n.revisar,r.n.formato,r.issues.map(i=>(i.sev==='error'?'✗ ':i.sev==='revisar'?'! ':'· ')+(FIELD_LABEL[i.f]||i.f)+': '+i.msg+(i.fix&&!i.msg.includes(i.fix)?' → '+i.fix:'')).join('\n'),r.special.hom?(r.special.hom==='confirmado'?'SÍ':'VERIFICAR')+' · '+r.special.homWhy:'',r.special.enf?(r.special.enf==='confirmado'?'SÍ':'VERIFICAR')+' · '+r.special.enfWhy:'']);
 const ws=sheetFrom(aoa);
 aoa[0].forEach((_,c)=>{const a=XLSX.utils.encode_cell({r:0,c});ws[a].s=headStyle()});
 S.recs.forEach((r,ri)=>{cols.forEach((c,ci)=>{const a=XLSX.utils.encode_cell({r:ri+1,c:ci});const raw=r.a[ci];if(!ws[a])ws[a]={t:'s',v:''};if(c==='FECHA'&&typeof raw==='number'){ws[a].z='dd/mm/yyyy'}
   const L=r.issues.filter(i=>i.f===c);const base={alignment:{vertical:'top',wrapText:c==='EXTRACTO'}};
   if(L.length){const w=L.find(i=>i.sev==='error')||L.find(i=>i.sev==='revisar')||L[0];ws[a].s=cellStyle(FILL[w.sev],w.sev==='error',w.sev==='error'?'9D1326':w.sev==='revisar'?'7A4A00':'2E4A6E');ws[a].c=[{a:'Auditor HERMES',t:L.map(i=>SEVN[i.sev]+': '+i.msg+(i.fix?' → '+i.fix:'')+'\n'+i.why).join('\n\n')}];ws[a].c.hidden=true}else ws[a].s=base});
  const st=XLSX.utils.encode_cell({r:ri+1,c:cols.length});ws[st].s=cellStyle(r.status==='error'?FILL.error:r.status==='revisar'?FILL.revisar:r.status==='formato'?FILL.formato:FILL.fix,true);
  const ob=XLSX.utils.encode_cell({r:ri+1,c:cols.length+4});ws[ob].s={alignment:{vertical:'top',wrapText:true}};
  if(r.special.hom){const a=XLSX.utils.encode_cell({r:ri+1,c:cols.length+5});ws[a].s=cellStyle(FILL.hom,true,'7D1235')}
  if(r.special.enf){const a=XLSX.utils.encode_cell({r:ri+1,c:cols.length+6});ws[a].s=cellStyle(FILL.enf,true,'56308A')}});
 ws['!cols']=widths(aoa[0]);ws['!autofilter']={ref:XLSX.utils.encode_range({s:{r:0,c:0},e:{r:aoa.length-1,c:aoa[0].length-1}})};
 const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Auditoría');
 /* observaciones */
 const o=[['FILA','PU','CAMPO','GRAVEDAD','PROBLEMA','CORRECCIÓN SUGERIDA','AUTOMÁTICA','DETALLE']];for(const r of S.recs)for(const i of r.issues)o.push([r.rowNo,r.pu,FIELD_LABEL[i.f]||i.f,SEVN[i.sev],i.msg,i.fix,i.auto&&i.fix?'Sí':'',i.why]);
 const wo=sheetFrom(o);o[0].forEach((_,c)=>wo[XLSX.utils.encode_cell({r:0,c})].s=headStyle());o.slice(1).forEach((row,ri)=>{const a=XLSX.utils.encode_cell({r:ri+1,c:3});wo[a].s=cellStyle(FILL[row[3]==='Error'?'error':row[3]==='Revisar'?'revisar':'formato'],true)});
 wo['!cols']=[{wch:6},{wch:9},{wch:13},{wch:10},{wch:36},{wch:30},{wch:10},{wch:70}];wo['!autofilter']={ref:XLSX.utils.encode_range({s:{r:0,c:0},e:{r:o.length-1,c:7}})};XLSX.utils.book_append_sheet(wb,wo,'Observaciones');
 /* especiales */
 for(const [kind,name] of [['hom','Homicidios'],['enf','Enfrentamientos']]){const L=S.recs.filter(r=>r.special[kind]);if(!L.length)continue;const f0=fichaFields(L[0],kind).map(x=>x[0]);const a=[['FILA','ESTADO','MOTIVO',...f0]];for(const r of L)a.push([r.rowNo,r.special[kind]==='confirmado'?'Confirmado':'Verificar',kind==='hom'?r.special.homWhy:r.special.enfWhy,...fichaFields(r,kind).map(x=>x[1])]);const w=sheetFrom(a);a[0].forEach((_,c)=>w[XLSX.utils.encode_cell({r:0,c})].s=headStyle());w['!cols']=widths(a[0]);XLSX.utils.book_append_sheet(wb,w,name)}
 const sum=[['AUDITOR HERMES v4.0'],['Archivo',S.file],['Módulo',S.mod==='relevantes'?'Hechos Relevantes':'Procedimientos'],['Fecha de auditoría',new Date().toLocaleString('es-AR')],['Registros',S.recs.length],['Con error',S.recs.filter(r=>r.status==='error').length],['A revisar',S.recs.filter(r=>r.status==='revisar').length],['Solo formato',S.recs.filter(r=>r.status==='formato').length],['Sin observaciones',S.recs.filter(r=>r.status==='ok').length],['Homicidios a cargar aparte',S.recs.filter(r=>r.special.hom).length],['Enfrentamientos a cargar aparte',S.recs.filter(r=>r.special.enf).length]];
 const wsum=sheetFrom(sum);wsum['!cols']=[{wch:32},{wch:50}];XLSX.utils.book_append_sheet(wb,wsum,'Resumen');
 XLSX.writeFile(wb,'AUDITORIA_'+S.file.replace(/\.(xlsx?|csv)$/i,'')+'.xlsx');toast('Auditoría descargada');
}
function exportFixed(){
 const H=S.origHeaders.map(String),cols=S.headers;const aoa=[[...H,'CAMBIOS AUTOMÁTICOS','PENDIENTE DE REVISAR']];const changed=[];
 for(const r of S.recs){const row=[],ch=[];cols.forEach((c,ci)=>{const orig=r.a[ci];let nv=orig;if(COLS[S.mod].includes(c)){nv=fixedValue(r,c);if(c==='FECHA')nv=orig}
   if(String(nv??'')!==String(orig??'')){ch.push({c,ci,orig});}row.push(nv)});
  changed.push(ch);aoa.push([...row,ch.map(x=>(FIELD_LABEL[x.c]||x.c)+(x.c==='EXTRACTO'?' (formato/ortografía)':clean(x.orig)===clean(row[x.ci])?' (espacios sobrantes)':': «'+clean(x.orig)+'» → «'+clean(row[x.ci])+'»')).join('\n'),r.issues.filter(i=>!(i.auto&&(i.fix||i.f==='EXTRACTO'))&&i.sev!=='formato').map(i=>(FIELD_LABEL[i.f]||i.f)+': '+i.msg+(i.fix?' → '+i.fix:'')).join('\n')])}
 const ws=sheetFrom(aoa);aoa[0].forEach((_,c)=>ws[XLSX.utils.encode_cell({r:0,c})].s=headStyle());
 S.recs.forEach((r,ri)=>{cols.forEach((c,ci)=>{const a=XLSX.utils.encode_cell({r:ri+1,c:ci});if(!ws[a])return;if(c==='FECHA'&&typeof r.a[ci]==='number')ws[a].z='dd/mm/yyyy';const ch=changed[ri].find(x=>x.ci===ci);
   if(ch){ws[a].s=cellStyle(FILL.fix,false,'0B4F3F');ws[a].c=[{a:'Auditor HERMES',t:'Antes: '+String(ch.orig??'').slice(0,800)}];ws[a].c.hidden=true}else ws[a].s={alignment:{vertical:'top',wrapText:c==='EXTRACTO'}};
   const pend=r.issues.filter(i=>i.f===c&&!(i.auto&&(i.fix||c==='EXTRACTO'))&&i.sev!=='formato');if(pend.length&&!ch)ws[a].s=cellStyle(FILL[pend.some(i=>i.sev==='error')?'error':'revisar'],true)});
  [cols.length,cols.length+1].forEach(c=>{const a=XLSX.utils.encode_cell({r:ri+1,c});if(ws[a])ws[a].s={alignment:{vertical:'top',wrapText:true},font:{color:{rgb:c===cols.length?'0B6B55':'9D1326'}}}})});
 ws['!cols']=widths(aoa[0]);const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,ws,'Hoja1');
 XLSX.writeFile(wb,S.file.replace(/\.(xlsx?|csv)$/i,'')+'_CORREGIDO.xlsx');toast('Planilla corregida descargada');
}
$('btnExport').addEventListener('click',()=>{try{exportAudit()}catch(e){console.error(e);toast('Error al exportar: '+e.message)}});
$('btnFixed').addEventListener('click',()=>{try{exportFixed()}catch(e){console.error(e);toast('Error al exportar: '+e.message)}});

/* ===== verificación online de direcciones ===== */
function extractAddress(r){
 let t=String(r.v.EXTRACTO||'').replace(/\([^()]*\)/g,' ').replace(/\s+/g,' ');
 if(S.mod==='procedimientos'){const o=t.match(/Objetivo\s*(?:1|[uú]nico)\s*:\s*([^.;]{4,90})/i);if(o)t=o[1]+' . '+t}
 const pats=[/\b(?:calles?|Av\.?|Avenida|Avda\.?)\s+([A-ZÁÉÍÓÚÑ0-9][^,.;()]{1,40}?)\s+(?:N[°º.]*\s*|Nro\.?\s*|al\s+)?(\d{1,5})\b/,/\b(?:calles?|Av\.?|Avenida)\s+([A-ZÁÉÍÓÚÑ0-9][^,.;()]{1,35}?)\s+y\s+([A-ZÁÉÍÓÚÑ0-9][^,.;()]{1,35}?)(?=[,.;]|\s+de\s|\s+(?:se|donde|procedi|lugar))/,/\binmediaciones de (?:calle\s+)?([A-ZÁÉÍÓÚÑ][^,.;()]{1,40}?)\s+(\d{1,5})\b/];
 for(const [n,re] of pats.entries()){const m=t.match(re);if(m){return n===1?m[1].trim()+' y '+m[2].trim():m[1].trim()+' '+m[2]}}return''}
$('btnGeo').addEventListener('click',async()=>{const T=S.recs.filter(r=>r.point).slice(0,60);$('btnGeo').disabled=true;let done=0,bad=0;
 for(const r of T){const addr=extractAddress(r);done++;$('geoStatus').textContent=`Consultando ${done}/${T.length}…`;if(!addr){r.geoNote='Sin calle y altura reconocibles en el extracto';continue}
  try{const loc=clean(fixedValue(r,'LOCALIDAD')),par=clean(fixedValue(r,'PARTIDO'));const q=[addr,loc,par!==loc?par:'','Buenos Aires','Argentina'].filter(Boolean).join(', ');
   const resp=await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=ar&q='+encodeURIComponent(q),{headers:{'Accept':'application/json'}});if(!resp.ok)throw Error('servicio '+resp.status);const j=await resp.json();
   r.issues=r.issues.filter(i=>i.code!=='GEO_DIST');
   if(j[0]){const d=kmBetween(r.point[0],r.point[1],+j[0].lat,+j[0].lon);r.geoNote=`Dirección «${addr}» ubicada a ${fmtKm(d)} de la coordenada`;if(d>1.5){bad++;r.issues.push({f:'COORDENADAS',sev:'revisar',code:'GEO_DIST','msg':'A '+fmtKm(d)+' de la dirección del extracto',why:'OpenStreetMap ubica «'+addr+'» ('+loc+') a '+fmtKm(d)+' de la coordenada cargada. Verificar.',fix:(+j[0].lat).toFixed(6)+', '+(+j[0].lon).toFixed(6),auto:false});finalize(r)}}
   else r.geoNote=`El mapa no encontró «${addr}»`}catch(e){r.geoNote='No verificable: '+e.message;if(/fetch|network|Failed/i.test(e.message)){$('geoStatus').textContent='Sin conexión con el servicio de mapas.';break}}
  await new Promise(res=>setTimeout(res,1100))}
 $('geoStatus').textContent=`Listo: ${bad} coordenadas lejos de la dirección del extracto.`;$('btnGeo').disabled=false;renderAll()});
</script>
